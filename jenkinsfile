pipeline {
    agent any

    tools {
        nodejs 'NodeJS' // Nom de l'outil configuré dans Jenkins
    }

    environment {
        DOCKER_IMAGE = 'julesbestdev176/isi_burger'
        DOCKER_TAG = 'latest'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'fall_souleymane_burger', url: 'https://github.com/JulesBestDev176/isi_burger.git'
            }
        }

        stage('Install Docker') {
            steps {
                script {
                    // Utilisation du script officiel d'installation Docker
                    sh """
                    # Mettre à jour les sources et installer les dépendances nécessaires
                    apt-get update
                    apt-get install -y apt-transport-https ca-certificates curl software-properties-common

                    # Installer Docker en utilisant le script officiel Docker
                    curl -fsSL https://get.docker.com | sh
                    """
                }
            }
        }

        stage('Docker Commands') {
            steps {
                script {
                    // Vérifier que Docker est installé et fonctionnel
                    sh 'docker --version'
                    sh 'docker pull docker:latest'
                }
            }
        }

        stage('Install Node.js') {
            steps {
                nodejs(nodeJSInstallationName: 'NodeJS') {
                    sh 'node --version'
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'docker-hub-password', variable: 'DOCKER_PASSWORD')]) {
                        sh """
                            echo ${DOCKER_PASSWORD} | docker login -u julesbestdev176 --password-stdin
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        """
                    }
                }
            }
        }

        stage('Deploy to Nginx Server') {
            steps {
                script {
                    withCredentials([sshUserPrivateKey(credentialsId: 'ssh-private-key', keyFileVariable: 'SSH_KEY')]) {
                        sh """
                            ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} user@your-server-ip <<EOF
                                docker pull ${DOCKER_IMAGE}:${DOCKER_TAG}
                                docker stop your-container-name || true
                                docker rm your-container-name || true
                                docker run -d --name your-container-name -p 80:80 ${DOCKER_IMAGE}:${DOCKER_TAG}
                            EOF
                        """
                    }
                }
            }
        }
    }
}
