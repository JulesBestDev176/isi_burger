pipeline {
    agent any

    tools {
        nodejs 'NodeJS' // Le nom que vous avez donné à votre installation NodeJS
    }

    environment {
        DOCKER_IMAGE = 'julesbestdev176/isi_burger'
        DOCKER_TAG = 'latest'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'fall_souleymane_burger', url: 'https://github.com/JulesBestDev176/isi_burger.git'
            }
        }

        

        stage('Install Node.js') {
            steps {
                nodejs(nodeJSInstallationName: 'NodeJS') {
                    sh 'node --version'
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    // Utiliser le secret Docker Hub
                    withCredentials([string(credentialsId: 'docker-hub-password', variable: 'DOCKER_PASSWORD')]) {
                        sh """
                            echo ${DOCKER_PASSWORD} | docker login -u julesbestdev176 --password-stdin
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        """
                    }
                }
            }
        }

        stage('Deploy to Nginx Server') {
            steps {
                script {
                    // Utiliser le secret SSH
                    withCredentials([string(credentialsId: 'ssh-private-key', variable: 'SSH_KEY')]) {
                        sh '''
                            echo "${SSH_KEY}" > /tmp/ssh_key
                            chmod 600 /tmp/ssh_key
                            ssh -o StrictHostKeyChecking=no -i /tmp/ssh_key user@your-server-ip \'
                                docker pull ${DOCKER_IMAGE}:${DOCKER_TAG}
                                docker stop your-container-name || true
                                docker rm your-container-name || true
                                docker run -d --name your-container-name -p 80:80 ${DOCKER_IMAGE}:${DOCKER_TAG}
                            \'
                            rm -f /tmp/ssh_key
                        '''
                    }
                }
            }
        }
    }
}