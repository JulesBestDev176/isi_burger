pipeline {
    agent {
        docker {
            image 'docker:latest'  // Utilise l'image Docker pour exécuter les étapes
            args '-e DOCKER_HOST=tcp://host.docker.internal:2375'  // Utilise Docker via TCP
        }
    }

    environment {
        GIT_REPO = 'https://github.com/JulesBestDev176/isi_burger.git'
        BRANCH_NAME = 'fall_souleymane_burger'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: "${GIT_REPO}", branch: "${BRANCH_NAME}"
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    sh 'composer install --no-dev --optimize-autoloader'
                    sh 'php artisan test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker-compose -f docker-compose.yml build --no-cache'
                }
            }
        }

        stage('Run Docker Containers') {
            steps {
                script {
                    sh 'docker-compose -f docker-compose.yml up -d'
                }
            }
        }

        stage('Clean Up') {
            steps {
                script {
                    sh 'docker-compose down'
                }
            }
        }
    }

    post {
        always {
            node('default') {  // Utilise un agent avec le label 'default'
                cleanWs()  // Nettoie l'espace de travail
            }
        }
        success {
            echo 'Pipeline exécuté avec succès!'
        }
        failure {
            echo 'Le pipeline a échoué.'
        }
    }
}